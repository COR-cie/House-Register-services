# Registre Foncier — configuration de déploiement
# Copiez ce fichier en .env puis renseignez toutes les valeurs « __A_CHANGER__ ».
# ⚠️ .env contient des secrets : ne le partagez pas, ne le versionnez pas.

# Ligne d'images à déployer :
#   latest = version stable (production)   ·   stage = pré-production
IMAGE_TAG=latest

# --- Sécurité ---
# Clé secrète (JWT + dérivation de la clé de chiffrement des pièces jointes).
# Générer :  openssl rand -hex 32
# ⚠️ NE JAMAIS MODIFIER après la 1re mise en service : les pièces déjà chiffrées
#    deviendraient illisibles.
SECRET_KEY=__A_CHANGER__

# --- Base de données ---
POSTGRES_USER=registre
POSTGRES_PASSWORD=__A_CHANGER__
POSTGRES_DB=registre_foncier

# --- Administrateur initial (créé au tout premier démarrage) ---
FIRST_ADMIN_IDENTIFIANT=admin
FIRST_ADMIN_PASSWORD=__A_CHANGER__
FIRST_ADMIN_NOM=Administrateur
FIRST_ADMIN_PRENOM=Systeme

# --- URL publique (CORS) ---
CORS_ORIGINS=https://registre.exemple.cg

# --- Téléversements ---
MAX_UPLOAD_MB=10
